<odoo>

    <record id="view_website_auto_translate_settings" model="ir.ui.view">
        <field name="name">website.auto.translate.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <!-- Add after the SEO block (last block with id=website_settings) -->
            <xpath expr="(//block[@id='website_settings'])[last()]" position="after">

                <block title="Auto Translation" id="website_auto_translation_settings">

                    <setting string="Google Auto Translate"
                             help="Automatically translate website content using Google Translate API">
                        <field name="enable_auto_translation"/>
                        <div class="content-group" invisible="not enable_auto_translation">
                            <div class="row mt16">
                                <label class="col-lg-3 o_light_label" string="API Key"
                                       for="google_translate_api_key"/>
                                <field name="google_translate_api_key"
                                       password="True"
                                       placeholder="Enter Google Translate API Key"/>
                            </div>
                        </div>
                    </setting>

                </block>

            </xpath>

        </field>
    </record>

</odoo>
